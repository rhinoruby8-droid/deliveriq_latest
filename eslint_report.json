eaking, sponsorship, or anything else ΓÇö we read every message.';\n\n  const jsonLd = {\n    '@context': 'https://schema.org',\n    '@type': 'ContactPage',\n    '@id': `${site}/contact#webpage`,\n    name: title,\n    url: `${site}/contact`,\n    description,\n    isPartOf: { '@id': `${site}/#website` },\n    about: { '@id': `${site}/#organization` },\n  };\n\n  const widgets = {\n    ContactForm: (\n      <div className=\"grid grid-cols-1 lg:grid-cols-[1fr_480px] gap-16 lg:gap-20 items-start\">\n        {/* Left col */}\n        <div>\n          <EyebrowLabel>Send a Message</EyebrowLabel>\n          <h2 className=\"text-3xl md:text-4xl font-bold text-[#F0EDE8] mb-4 leading-tight\">\n            Get in touch.\n          </h2>\n          <p className=\"text-sm text-[#8A8D96] leading-relaxed mb-8\">\n            Fill in the form and we'll get back to you. Prefer email? Reach us directly at{' '}\n            <a href=\"mailto:info@deliveriq.live\" className=\"text-[#C79A4E] hover:underline\">\n              info@deliveriq.live\n            </a>\n            .\n          </p>\n          <div className=\"flex items-center gap-3 text-sm text-[#8A8D96]\">\n            <Mail size={14} className=\"text-[#C79A4E] shrink-0\" />\n            <span>We aim to respond within 2 business days.</span>\n          </div>\n        </div>\n\n        {/* Form */}\n        <div>\n          {submitted ? (\n            <div className=\"flex flex-col gap-4 p-8 border border-[#C79A4E]/30 rounded-sm bg-[#1A1D24]\">\n              <CheckCircle size={24} className=\"text-[#C79A4E]\" />\n              <h3 className=\"text-lg font-semibold text-[#F0EDE8]\">Message received.</h3>\n              <p className=\"text-sm text-[#8A8D96] leading-relaxed\">\n                Thanks for getting in touch. We'll get back to you within 2 business days.\n              </p>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"flex flex-col gap-5\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-xs font-semibold tracking-wide text-[#8A8D96] uppercase\">\n                    Name <span className=\"text-[#C79A4E]\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    name=\"name\"\n                    value={formData.name}\n                    onChange={handleChange}\n                    required\n                    placeholder=\"Your name\"\n                    className=\"bg-[#1A1D24] border border-[#2C2F38] text-[#F0EDE8] placeholder-[#8A8D96] px-4 py-3 text-sm rounded focus:outline-none focus:border-[#C79A4E] transition-colors\"\n                  />\n                </div>\n                <div className=\"flex flex-col gap-2\">\n                  <label className=\"text-xs font-semibold tracking-wide text-[#8A8D96] uppercase\">\n                    Email <span className=\"text-[#C79A4E]\">*</span>\n                  </label>\n                  <input\n                    type=\"email\"\n                    name=\"email\"\n                    value={formData.email}\n                    onChange={handleChange}\n                    required\n                    placeholder=\"you@company.com\"\n                    className=\"bg-[#1A1D24] border border-[#2C2F38] text-[#F0EDE8] placeholder-[#8A8D96] px-4 py-3 text-sm rounded focus:outline-none focus:border-[#C79A4E] transition-colors\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-2\">\n                <label className=\"text-xs font-semibold tracking-wide text-[#8A8D96] uppercase\">\n                  Subject\n                </label>\n                <select\n                  name=\"subject\"\n                  value={formData.subject}\n                  onChange={handleChange}\n                  className=\"bg-[#1A1D24] border border-[#2C2F38] text-[#F0EDE8] px-4 py-3 text-sm rounded focus:outline-none focus:border-[#C79A4E] transition-colors appearance-none\"\n                >\n                  <option value=\"\">Select a subject</option>\n                  <option value=\"general\">General enquiry</option>\n                  <option value=\"speaking\">Speaking</option>\n                  <option value=\"sponsorship\">Sponsorship</option>\n                  <option value=\"feedback\">Feedback</option>\n                  <option value=\"other\">Other</option>\n                </select>\n              </div>\n\n              <div className=\"flex flex-col gap-2\">\n                <label className=\"text-xs font-semibold tracking-wide text-[#8A8D96] uppercase\">\n                  Message <span className=\"text-[#C79A4E]\">*</span>\n                </label>\n                <textarea\n                  name=\"message\"\n                  value={formData.message}\n                  onChange={handleChange}\n                  required\n                  rows={5}\n                  placeholder=\"How can we help?\"\n                  className=\"bg-[#1A1D24] border border-[#2C2F38] text-[#F0EDE8] placeholder-[#8A8D96] px-4 py-3 text-sm rounded focus:outline-none focus:border-[#C79A4E] transition-colors resize-none\"\n                />\n              </div>\n\n              <div className=\"pt-2\">\n                <button\n                  type=\"submit\"\n                  className=\"inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold bg-[#C79A4E] text-[#1A1D24] rounded transition-all duration-200 hover:brightness-110 hover:scale-[1.02]\"\n                >\n                  Send Message <ArrowRight size={14} />\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    )\n  };\n\n  return (\n    <>\n      <Helmet>\n        <title>{title}</title>\n        <meta name=\"description\" content={description} />\n  