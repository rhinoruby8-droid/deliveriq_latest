\n  const [email, setEmail] = useState('');\n  const [name, setName] = useState('');\n  const [discipline, setDiscipline] = useState('');\n  const [submitted, setSubmitted] = useState(false);\n\n  // Find matching session if slug provided\n  const matchedSession = (cms?.sessions || []).find(s => s.id === sessionSlug);\n\n  // Pre-select discipline based on session tag\n  useEffect(() => {\n    if (matchedSession) {\n      if (matchedSession.tag === 'Project Management') {\n        setDiscipline('Project Management');\n      } else if (matchedSession.tag === 'Project Controls') {\n        setDiscipline('Project Controls');\n      } else if (matchedSession.tag === 'Delivery Leadership') {\n        setDiscipline('Delivery Leadership / PMO');\n      }\n    }\n  }, [matchedSession]);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !name) return;\n    setSubmitted(true);\n    \n    const sourceLabel = matchedSession \n      ? `register:${matchedSession.title}` \n      : 'register';\n\n    await notifySubmission({ source: sourceLabel, name, email, discipline });\n  };\n\n  const disciplines = [\n    'Project Management',\n    'Project Controls',\n    'Delivery Leadership / PMO',\n    'Programme Management',\n    'Other'\n  ];\n\n  const benefits = [\n    { icon: Calendar, text: 'Priority notification when registration opens' },\n    { icon: Zap, text: 'Early access to session topics and schedules' },\n    { icon: Users, text: 'Join a community of project professionals upskilling in AI' },\n    { icon: Repeat, text: 'Replay access included with every session' }\n  ];\n\n  return (\n    <>\n      <Helmet>\n        <title>{title}</title>\n        <meta name=\"description\" content={description} />\n        <link rel=\"canonical\" href={canonicalUrl} />\n        <meta property=\"og:title\" content={title} />\n        <meta property=\"og:description\" content={description} />\n        <meta property=\"og:url\" content={canonicalUrl} />\n        <meta property=\"og:type\" content=\"website\" />\n        <meta property=\"og:image\" content={`${site}/airo-assets/images/logo/horizontal`} />\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content={title} />\n        <meta name=\"twitter:description\" content={description} />\n        <meta name=\"twitter:image\" content={`${site}/airo-assets/images/logo/horizontal`} />\n        <script type=\"application/ld+json\">{JSON.stringify(jsonLd)}</script>\n      </Helmet>\n\n      <main>\n        {/* ΓöÇΓöÇ PAGE HEADER ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"relative overflow-hidden pt-20 pb-16 lg:pt-28 lg:pb-20\">\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              backgroundImage: `\n                linear-gradient(rgba(44,47,56,0.35) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(44,47,56,0.35) 1px, transparent 1px)\n              `,\n              backgroundSize: '48px 48px'\n            }}\n          />\n          \n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              background:\n                'radial-gradient(ellipse 50% 60% at 20% 50%, rgba(199,154,78,0.06) 0%, transparent 70%)'\n            }}\n          />\n          \n          <div className=\"container mx-auto px-6 lg:px-8 relative z-10\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center\">\n              {/* Left: text */}\n              <motion.div initial=\"hidden\" animate=\"visible\" variants={stagger}>\n                <motion.div variants={fadeUp} custom={0}>\n                  <EyebrowLabel>Register Your Interest</EyebrowLabel>\n                </motion.div>\n                <motion.div variants={fadeUp} custom={0.05}>\n                  {matchedSession ? (\n                    <h1 className=\"text-4xl md:text-5xl font-bold text-[#F0EDE8] leading-tight mb-5\">\n                      Register for:<br />\n                      <span className=\"text-[#C79A4E]\">{matchedSession.title}</span>\n                    </h1>\n                  ) : (\n                    <h1 className=\"text-4xl md:text-5xl font-bold text-[#F0EDE8] leading-tight mb-5\">\n                      Registrations<br />\n                      <span className=\"text-[#C79A4E]\">opening soon!</span>\n                    </h1>\n                  )}\n                </motion.div>\n                <motion.p\n                  variants={fadeUp}\n                  custom={0.1}\n                  className=\"text-lg text-[#8A8D96] leading-relaxed max-w-xl mb-8\">\n                  {matchedSession ? (\n                    `Complete the form to register your priority seat for \"${matchedSession.title}\". We'll notify you as soon as details are locked in.`\n                  ) : (\n                    \"Live sessions for project professionals who want to apply AI in real delivery work ΓÇö not theory, not hype. Add your name below and we'll reach out the moment registration opens.\"\n                  )}\n                </motion.p>\n                <motion.ul\n                  variants={stagger}\n                  initial=\"hidden\"\n                  animate=\"visible\"\n                  className=\"flex flex-col gap-3\">\n                  {benefits.map((b) => (\n                    <motion.li\n                      key={b.text}\n                      variants={fadeUp}\n                      custom={0.15}\n                      className=\"flex items-start gap-3 text-sm text-[#8A8D96]\">\n                      <b.icon size={15} className=\"text-[#C79A4E] shrink-0 mt-0.5\" />\n                      {b.text}\n                    </motion.li>\n                  ))}\n                </motion.ul>\n              </motion.div>\n\n              {/* Right: form */}\n              <motion.div\n                initial={{ opacity: 0, x: 24 }}\n                animate={{ opacity: 1, x: 0 }}\n                transition={{ duration: 0.7, ease: 'easeOut' as const, delay: 0.3 }}>\n                <div className=\"border border-[#2C2F38] bg-[#21242C] rounded-sm overflow-hidden\">\n                  <div className=\"px-6 py-5 border-b border-[#2C2F38]\">\n                    <p className=\"text-[10px] font-semibold tracking-widest text-[#C79A4E] uppercase\">\n                      {matchedSession ? 'Session Registration' : 'Register your interest'}\n                    </p>\n                  </div>\n\n                  {submitted ? (\n                    <div className=\"px-6 py-12 flex flex-col items-center text-center gap-4\">\n                      <CheckCircle size={40} className=\"text-[#C79A4E]\" />\n                      <h2 className=\"text-xl font-bold text-[#F0EDE8]\">You're on the list</h2>\n                      <p className=\"text-sm text-[#8A8D96] max-w-xs leading-relaxed\">\n                        We'll notify you as soon as registration opens. Keep an eye on your inbox.\n                      </p>\n                    </div>\n                  ) : (\n                    <form onSubmit={handleSubmit} className=\"px-6 py-6 flex flex-col gap-5\">\n                      \n                      {/* Match Session summary block */}\n                      {matchedSession && (\n                        <div className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm p-4 text-xs\">\n                          <span className=\"text-[9px] font-bold text-[#C79A4E] uppercase tracking-wider block mb-1\">{matchedSession.tag}</span>\n                          <h4 className=\"font-bold text-[#F0EDE8] mb-1 leading-snug\">{matchedSession.title}</h4>\n                          <p className=\"text-[#8A8D96] mb-3 leading-relaxed\">{matchedSession.description}</p>\n                          <span className=\"text-[10px] text-[#8A8D96] block\">Schedule: {matchedSession.date} @ {matchedSession.time} ({matchedSession.duration})</span>\n                        </div>\n                      )}\n\n                      {/* Name */}\n                      <div className=\"flex flex-col gap-1.5\">\n                        <label\n                          htmlFor=\"reg-name\"\n                          className=\"text-xs font-semibold text-[#8A8D96] uppercase tracking-wider\"\n                        >\n                          Full name <span className=\"text-[#C79A4E]\">*</span>\n                        </label>\n                        <input\n                          id=\"reg-name\"\n                          type=\"text\"\n                          required\n                          value={name}\n                          onChange={(e) => setName(e.target.value)}\n                          placeholder=\"Your name\"\n                          className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm px-4 py-3 text-sm text-[#F0EDE8] placeholder-[#4A4D56] focus:outline-none focus:border-[#C79A4E]/60 transition-colors\"\n                        />\n                      </div>\n\n                      {/* Email */}\n                      <div className=\"flex flex-col gap-1.5\">\n                        <label\n                          htmlFor=\"reg-email\"\n                          className=\"text-xs font-semibold text-[#8A8D96] uppercase tracking-wider\"\n                        >\n                          Work email <span className=\"text-[#C79A4E]\">*</span>\n                        </label>\n                        <input\n                          id=\"reg-email\"\n                          type=\"email\"\n                          required\n                          value={email}\n                          onChange={(e) => setEmail(e.target.value)}\n                          placeholder=\"you@company.com\"\n                          className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm px-4 py-3 text-sm text-[#F0EDE8] placeholder-[#4A4D56] focus:outline-none focus:border-[#C79A4E]/60 transition-colors\"\n                        />\n                      </div>\n\n                      {/* Discipline */}\n                      <div className=\"flex flex-col gap-1.5\">\n                        <label\n                          htmlFor=\"reg-discipline\"\n                          className=\"text-xs font-semibold text-[#8A8D96] uppercase tracking-wider\"\n                        >\n                          Your discipline\n                        </label>\n                        <select\n                          id=\"reg-discipline\"\n                          value={discipline}\n                          onChange={(e) => setDiscipline(e.target.value)}\n                          className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm px-4 py-3 text-sm text-[#F0EDE8] focus:outline-none focus:border-[#C79A4E]/60 transition-colors appearance-none\"\n                        >\n                          <option value=\"\" className=\"text-[#4A4D56]\">Select your discipline</option>\n                          {disciplines.map((d) => (\n                            <option key={d} value={d}>{d}</option>\n                          ))}\n                        </select>\n                      </div>\n\n                      <button\n                        type=\"submit\"\n                        className=\"mt-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold bg-[#C79A4E] text-[#1A1D24] rounded transition-all duration-200 hover:brightness-110 hover:scale-[1.02]\"\n                      >\n                        {matchedSession ? 'Register My Interest' : 'Notify me when registration opens'} <ArrowRight size={14} />\n                      </button>\n\n                      <p className=\"text-[11px] text-[#4A4D56] text-center leading-relaxed\">\n                        No spam. We'll only contact you about session registration.\n                      </p>\n                    </form>\n                  )}\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-[#C79A4E]/30\" />\n\n        {/* ΓöÇΓöÇ WHAT TO EXPECT ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"py-20 lg:py-28\">\n          <div className=\"container mx-auto px-6 lg:px-8\">\n            <motion.div\n              initial=\"hidden\"\n              whileInView=\"visible\"\n              viewport={{ once: true }}\n              variants={stagger}\n              className=\"max-w-2xl mx-auto text-center mb-14\"\n            >\n              <motion.div variants={fadeUp} custom={0}>\n                <EyebrowLabel>What to expect</EyebrowLabel>\n              </motion.div>\n              <motion.h2\n                variants={fadeUp}\n                custom={0.05}\n                className=\"text-3xl md:text-4xl font-bold text-[#F0EDE8] leading-tight\"\n              >\n                Sessions built for how project professionals actually work\n              </motion.h2>\n            </motion.div>\n\n            <motion.div\n              initial=\"hidden\"\n              whileInView=\"visible\"\n              viewport={{ once: true }}\n              variants={stagger}\n              className=\"grid grid-cols-1 md:grid-cols-3 gap-6\"\n            >\n              {[\n                {\n                  num: '01',\n                  title: 'Live and interactive',\n                  body: 'Every session is delivered live with real Q&A ΓÇö not pre-recorded content you watch alone.'\n                },\n                {\n                  num: '02',\n                  title: 'Practical, not theoretical',\n                  body: 'Topics are drawn from real project delivery challenges. You leave with techniques you can apply immediately.'\n                },\n                {\n                  num: '03',\n                  title: 'Replay included',\n                  body: \"Can't make the live time? Every registered attendee gets full replay access after the session.\"\n                }\n              ].map((item) => (\n                <motion.div\n                  key={item.num}\n                  variants={fadeUp}\n                  custom={0}\n                  className=\"border border-[#2C2F38] bg-[#21242C] rounded-sm px-6 py-7\"\n                >\n                  <p className=\"text-4xl font-black text-[#2C2F38] mb-4 leading-none\">{item.num}</p>\n                  <h3 className=\"text-base font-bold text-[#F0EDE8] mb-2\">{item.title}</h3>\n                  <p\n                    className=\"text-sm text-[#8A8D96] leading-relaxed\"\n                    dangerouslySetInnerHTML={{ __html: item.body }}\n                  />\n                </motion.div>\n              ))}\n            </motion.div>\n          </div>\n        </section>\n      </main>\n    </>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"D:\\DeliverIQ\\DeliverIQ\\src\\pages\\replays.tsx","messages":[{"ruleId":"no-undef","severity":2,"message":"'React' is not defined.","line":28,"column":49,"nodeType":"Identifier","messageId":"undef","endLine":28,"endColumn":54},{"ruleId":"no-undef","severity":2,"message":"'HTMLImageElement' is not defined.","line":303,"column":66,"nodeType":"Identifier","messageId":"undef","endLine":303,"endColumn":82}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Helmet } from '@dr.pogodin/react-helmet';\nimport { Link } from 'react-router-dom';\nimport { notifySubmission } from '@/lib/notify';\nimport { useCmsContent } from '@/lib/cms-client';\nimport { motion } from 'motion/react';\nimport { useState } from 'react';\nimport { Play, Clock, ArrowRight, X } from 'lucide-react';\n\n// ΓöÇΓöÇΓöÇ Animation helpers ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nconst fadeUp = {\n  hidden: { opacity: 0, y: 24 },\n  visible: (delay = 0) => ({\n    opacity: 1,\n    y: 0,\n    transition: { duration: 0.5, ease: 'easeOut' as const, delay },\n  }),\n};\n\nconst stagger = {\n  hidden: {},\n  visible: { transition: { staggerChildren: 0.1 } },\n};\n\n// ΓöÇΓöÇΓöÇ Data ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nconst tags = ['All', 'Project Controls', 'Project Management', 'Delivery Leadership'];\n\n// ΓöÇΓöÇΓöÇ Sub-components ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nfunction EyebrowLabel({ children }: { children: React.ReactNode }) {\n  return (\n    <p className=\"text-xs font-semibold tracking-[0.2em] text-[#C79A4E] uppercase mb-4\">\n      {children}\n    </p>\n  );\n}\n\n// ΓöÇΓöÇΓöÇ Page ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nexport default function ReplaysPage() {\n  const { data: cms } = useCmsContent();\n  const [activeTag, setActiveTag] = useState('All');\n  const [email, setEmail] = useState('');\n  const [submitted, setSubmitted] = useState(false);\n  const [playingVideoUrl, setPlayingVideoUrl] = useState<string | null>(null);\n\n  const site = 'https://deliveriq.live';\n  const title = 'Replays ΓÇö DeliverIQ';\n  const description =\n    'Access replays of past DeliverIQ sessions on AI for project management, project controls, and delivery professionals.';\n\n  const jsonLd = {\n    '@context': 'https://schema.org',\n    '@type': 'WebPage',\n    '@id': `${site}/replays#webpage`,\n    name: title,\n    url: `${site}/replays`,\n    description,\n    isPartOf: { '@id': `${site}/#website` },\n    about: { '@id': `${site}/#organization` },\n  };\n\n  // Filter sessions that are published AND have videoUrl\n  const allReplays = (cms?.sessions || []).filter(s => s.status === 'published' && s.videoUrl);\n  const filteredReplays = activeTag === 'All' \n    ? allReplays \n    : allReplays.filter(s => s.tag === activeTag);\n\n  return (\n    <>\n      <Helmet>\n        <title>{title}</title>\n        <meta name=\"description\" content={description} />\n        <link rel=\"canonical\" href={`${site}/replays`} />\n        <meta property=\"og:title\" content={title} />\n        <meta property=\"og:description\" content={description} />\n        <meta property=\"og:type\" content=\"website\" />\n        <meta property=\"og:url\" content={`${site}/replays`} />\n        <meta property=\"og:image\" content={`${site}/airo-assets/images/logo/horizontal`} />\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content={title} />\n        <meta name=\"twitter:description\" content={description} />\n        <meta name=\"twitter:image\" content={`${site}/airo-assets/images/logo/horizontal`} />\n        <script type=\"application/ld+json\">{JSON.stringify(jsonLd)}</script>\n      </Helmet>\n\n      <main>\n        {/* ΓöÇΓöÇ PAGE HEADER ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"relative overflow-hidden pt-20 pb-16 lg:pt-28 lg:pb-20\">\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              backgroundImage: `\n                linear-gradient(rgba(44,47,56,0.35) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(44,47,56,0.35) 1px, transparent 1px)\n              `,\n              backgroundSize: '48px 48px',\n            }}\n          />\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              background:\n                'radial-gradient(ellipse 50% 60% at 20% 50%, rgba(199,154,78,0.06) 0%, transparent 70%)',\n            }}\n          />\n          <div className=\"container mx-auto px-6 lg:px-8 relative z-10\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center\">\n              {/* Left: text */}\n              <motion.div\n                initial=\"hidden\"\n                animate=\"visible\"\n                variants={stagger}\n              >\n                <motion.div variants={fadeUp} custom={0}>\n                  <EyebrowLabel>Replays</EyebrowLabel>\n                </motion.div>\n                <motion.div variants={fadeUp} custom={0.05}>\n                  <h1 className=\"text-4xl md:text-5xl font-bold text-[#F0EDE8] leading-tight mb-5\">\n                    Past sessions.\n                    <br />\n                    <span className=\"text-[#C79A4E]\">On demand.</span>\n                  </h1>\n                </motion.div>\n                <motion.p\n                  variants={fadeUp}\n                  custom={0.1}\n                  className=\"text-lg text-[#8A8D96] leading-relaxed max-w-xl\"\n                >\n                  Missed a live session? Replays will be available here after each event. Sign up\n                  below to be notified when the first replays go live.\n                </motion.p>\n              </motion.div>\n\n              {/* Right: video preview */}\n              <motion.div\n                initial={{ opacity: 0, x: 24 }}\n                animate={{ opacity: 1, x: 0 }}\n                transition={{ duration: 0.7, ease: 'easeOut' as const, delay: 0.3 }}\n                className=\"hidden lg:block\"\n              >\n                <div className=\"relative rounded-sm overflow-hidden border border-[#2C2F38]\">\n                  <div className=\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#C79A4E]/50 to-transparent z-10\" />\n                  <div className=\"aspect-video bg-[#21242C]\">\n                    <video\n                      src=\"/airo-assets/videos/pages/replays/preview\"\n                      autoPlay\n                      muted\n                      loop\n                      playsInline\n                      className=\"w-full h-full object-cover opacity-90\"\n                    />\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-[#1A1D24]/50 to-transparent pointer-events-none\" />\n                  </div>\n                  <div className=\"bg-[#21242C] px-4 py-3 flex items-center gap-2 border-t border-[#2C2F38]\">\n                    <Play size={11} className=\"text-[#C79A4E]\" />\n                    <span className=\"text-[11px] font-semibold text-[#C79A4E] uppercase tracking-wider\">Replays available after each live session</span>\n                  </div>\n                </div>\n              </motion.div>\n            </div>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-[#C79A4E]/30\" />\n\n        {/* ΓöÇΓöÇ NOTIFY STRIP ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"bg-[#21242C] py-10\">\n          <div className=\"container mx-auto px-6 lg:px-8\">\n            <motion.div\n              initial=\"hidden\"\n              animate=\"visible\"\n              variants={stagger}\n              className=\"flex flex-col md:flex-row md:items-center gap-6 md:gap-10\"\n            >\n              <motion.div variants={fadeUp} custom={0} className=\"flex-1\">\n                <p className=\"text-base font-semibold text-[#F0EDE8] mb-1\">\n                  Get notified when replays are available.\n                </p>\n                <p className=\"text-sm text-[#8A8D96]\">\n                  We'll let you know as soon as the first sessions are published.\n                </p>\n              </motion.div>\n              <motion.div variants={fadeUp} custom={0.05} className=\"flex-1 max-w-md\">\n                {submitted ? (\n                  <div className=\"flex items-center gap-3 text-sm text-[#C79A4E]\">\n                    <Play size={14} />\n                    <span>You're on the list. We'll be in touch.</span>\n                  </div>\n                ) : (\n                  <form\n                    onSubmit={async (e) => {\n                      e.preventDefault();\n                      setSubmitted(true);\n                      await notifySubmission({ source: 'replays', email });\n                      setEmail('');\n                    }}\n                    className=\"flex gap-3\"\n                  >\n                    <input\n                      type=\"email\"\n                      value={email}\n                      onChange={(e) => setEmail(e.target.value)}\n                      placeholder=\"Your work email\"\n                      required\n                      className=\"flex-1 bg-[#1A1D24] border border-[#2C2F38] text-[#F0EDE8] placeholder-[#8A8D96] px-4 py-2.5 text-sm rounded focus:outline-none focus:border-[#C79A4E] transition-colors\"\n                    />\n                    <button\n                      type=\"submit\"\n                      className=\"px-5 py-2.5 text-sm font-semibold bg-[#C79A4E] text-[#1A1D24] rounded transition-all duration-200 hover:brightness-110 whitespace-nowrap\"\n                    >\n                      Notify Me\n                    </button>\n                  </form>\n                )}\n              </motion.div>\n            </motion.div>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-[#2C2F38]\" />\n\n        {/* ΓöÇΓöÇ DYNAMIC REPLAYS ARCHIVE ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"py-20 lg:py-28\">\n          <div className=\"container mx-auto px-6 lg:px-8\">\n            {/* Filter tabs */}\n            <motion.div\n              initial=\"hidden\"\n              animate=\"visible\"\n              variants={stagger}\n              className=\"mb-12\"\n            >\n              <motion.div variants={fadeUp} custom={0} className=\"flex flex-wrap gap-2 mb-12\">\n                {tags.map((tag) => (\n                  <button\n                    key={tag}\n                    onClick={() => setActiveTag(tag)}\n                    className={`text-xs font-semibold tracking-wide px-4 py-2 rounded-sm border transition-all duration-200 ${\n                      activeTag === tag\n                        ? 'bg-[#C79A4E] text-[#1A1D24] border-[#C79A4E]'\n                        : 'bg-transparent text-[#8A8D96] border-[#2C2F38] hover:border-[#C79A4E]/50 hover:text-[#F0EDE8]'\n                    }`}\n                  >\n                    {tag}\n                  </button>\n                ))}\n              </motion.div>\n\n              {/* Conditional Display */}\n              {filteredReplays.length > 0 ? (\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                  {filteredReplays.map((session) => {\n                    const sessionSpeakers = (cms?.speakers || []).filter(s => (session.speakerIds || []).includes(s.id));\n                    return (\n                      <motion.div\n                        key={session.id}\n                        variants={fadeUp}\n                        className=\"border border-[#2C2F38] bg-[#21242C]/40 rounded-sm overflow-hidden flex flex-col hover:border-[#C79A4E]/30 transition-all duration-300 group\"\n                      >\n                        {/* Video thumbnail play area */}\n                        <div\n                          onClick={() => setPlayingVideoUrl(session.videoUrl || null)}\n                          className=\"aspect-video bg-[#1A1D24] relative cursor-pointer overflow-hidden border-b border-[#2C2F38]\"\n                        >\n                          <div className=\"absolute inset-0 bg-gradient-to-tr from-[#1A1D24] to-[#C79A4E]/5 flex items-center justify-center\">\n                            <span className=\"text-[10px] font-mono text-[#4A4D56] tracking-wider uppercase select-none\">{session.tag}</span>\n                          </div>\n                          <div className=\"absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors duration-300\" />\n                          \n                          <div className=\"absolute inset-0 flex items-center justify-center\">\n                            <div className=\"w-12 h-12 rounded-full bg-[#1A1D24]/90 border border-[#C79A4E]/30 flex items-center justify-center text-[#C79A4E] group-hover:bg-[#C79A4E] group-hover:text-[#1A1D24] transition-all duration-300 scale-95 group-hover:scale-105 shadow-xl\">\n                              <Play size={16} fill=\"currentColor\" className=\"ml-0.5\" />\n                            </div>\n                          </div>\n                        </div>\n\n                        {/* Card Info */}\n                        <div className=\"p-5 flex-1 flex flex-col justify-between\">\n                          <div>\n                            <div className=\"flex items-center justify-between gap-2 mb-2\">\n                              <span className=\"text-[9px] font-bold text-[#C79A4E] uppercase tracking-wider bg-[#C79A4E]/5 border border-[#C79A4E]/10 px-2 py-0.5 rounded-sm\">\n                                {session.tag}\n                              </span>\n                              <span className=\"text-[10px] text-[#8A8D96] flex items-center gap-1\">\n                                <Clock size={11} /> {session.duration}\n                              </span>\n                            </div>\n                            <h3 className=\"font-bold text-base text-[#F0EDE8] mb-2 leading-snug group-hover:text-[#C79A4E] transition-colors\">\n                              {session.title}\n                            </h3>\n                            <p className=\"text-xs text-[#8A8D96] leading-relaxed mb-4 line-clamp-2\">\n                              {session.description}\n                            </p>\n                          </div>\n\n                          {/* Presenters */}\n                          <div className=\"pt-4 border-t border-[#2C2F38]/40 flex items-center gap-2\">\n                            <div className=\"flex -space-x-1.5 overflow-hidden shrink-0\">\n                              {sessionSpeakers.map(sp => (\n                                <img\n                                  key={sp.id}\n                                  src={sp.avatarUrl}\n                                  alt={sp.name}\n                                  onError={(e) => { (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=32&h=32'; }}\n                                  className=\"inline-block h-6 w-6 rounded-full ring-2 ring-[#21242C] object-cover bg-[#1A1D24]\"\n                                  title={sp.name}\n                                />\n                              ))}\n                            </div>\n                            <span className=\"text-[10px] text-[#8A8D96] font-medium truncate\">\n                              {sessionSpeakers.map(s => s.name).join(', ') || 'TBA'}\n                            </span>\n                          </div>\n                        </div>\n                      </motion.div>\n                    );\n                  })}\n                </div>\n              ) : (\n                /* Empty state */\n                <motion.div\n                  variants={fadeUp}\n                  custom={0.1}\n                  className=\"flex flex-col items-center justify-center py-24 border border-dashed border-[#2C2F38] rounded-sm text-center\"\n                >\n                  <div className=\"w-14 h-14 rounded-full border border-[#2C2F38] flex items-center justify-center mb-6\">\n                    <img\n                      src=\"/airo-assets/images/logo/icon-dark\"\n                      alt=\"DeliverIQ\"\n                      className=\"w-8 h-8 object-contain\"\n                    />\n                  </div>\n                  <p className=\"text-lg font-semibold text-[#F0EDE8] mb-2\">\n                    Replays coming soon.\n                  </p>\n                  <p className=\"text-sm text-[#8A8D96] max-w-sm leading-relaxed\">\n                    The first live sessions are on their way. Once they've aired, replays will appear\n                    here ΓÇö filterable by topic and available on demand.\n                  </p>\n                  <Link\n                    to=\"/sessions\"\n                    className=\"mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[#C79A4E] border border-[#C79A4E]/40 px-5 py-2.5 rounded-sm hover:bg-[#C79A4E]/10 transition-colors\"\n                  >\n                    See upcoming sessions <ArrowRight size={14} />\n                  </Link>\n                </motion.div>\n              )}\n            </motion.div>\n          </div>\n        </section>\n\n        <div className=\"w-full h-px bg-[#C79A4E]/30\" />\n\n        {/* ΓöÇΓöÇ WHAT TO EXPECT ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"py-20 lg:py-24 bg-[#21242C]\">\n          <div className=\"container mx-auto px-6 lg:px-8\">\n            <motion.div\n              initial=\"hidden\"\n              whileInView=\"visible\"\n              viewport={{ once: true, margin: '-60px' }}\n              variants={stagger}\n            >\n              <motion.div variants={fadeUp} custom={0}>\n                <EyebrowLabel>What to Expect</EyebrowLabel>\n              </motion.div>\n              <motion.h2\n                variants={fadeUp}\n                custom={0.05}\n                className=\"text-3xl md:text-4xl font-bold text-[#F0EDE8] mb-12 max-w-xl leading-tight\"\n              >\n                Every replay. Exactly as it aired.\n              </motion.h2>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-0\">\n                {[\n                  {\n                    number: '01',\n                    title: 'Full session recording',\n                    body: 'The complete live session ΓÇö presentation, demonstrations, and the full Q&A ΓÇö unedited and uncut.',\n                  },\n                  {\n                    number: '02',\n                    title: 'Organised by topic',\n                    body: \"Filter replays by discipline ΓÇö project controls, project management, or delivery leadership ΓÇö to find what's most relevant to you.\",\n                  },\n                  {\n                    number: '03',\n                    title: 'Available on demand',\n                    body: 'Watch at your own pace, on your schedule. No expiry, no time pressure.',\n                  },\n                ].map((item, i) => (\n                  <motion.div\n                    key={i}\n                    variants={fadeUp}\n                    custom={i * 0.1}\n                    className=\"flex flex-col gap-3 py-8 px-0 md:px-8 border-t border-[#2C2F38] md:border-t-0 md:border-l first:border-l-0\"\n                  >\n                    <div className=\"flex items-center gap-3 mb-1\">\n                      <span className=\"text-3xl font-bold text-[#2C2F38]\">{item.number}</span>\n                      <Clock size={14} className=\"text-[#C79A4E]\" />\n                    </div>\n                    <h3 className=\"text-base font-semibold text-[#F0EDE8]\">{item.title}</h3>\n                    <p className=\"text-sm text-[#8A8D96] leading-relaxed\">{item.body}</p>\n                  </motion.div>\n                ))}\n              </div>\n            </motion.div>\n          </div>\n        </section>\n      </main>\n\n      {/* ΓöÇΓöÇ PREMIUM LIGHTBOX VIDEO MODAL ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n      {playingVideoUrl && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-md p-4\">\n          <div className=\"w-full max-w-4xl bg-[#21242C] border border-[#2C2F38] rounded-sm overflow-hidden relative shadow-2xl animate-fade-in\">\n            <button\n              onClick={() => setPlayingVideoUrl(null)}\n              className=\"absolute top-4 right-4 z-10 p-2 bg-[#1A1D24]/80 text-[#8A8D96] hover:text-[#F0EDE8] border border-[#2C2F38] rounded-full transition-colors\"\n              title=\"Close Player\"\n            >\n              <X size={14} />\n            </button>\n            <div className=\"aspect-video bg-black\">\n              <video\n                src={playingVideoUrl}\n                controls\n                autoPlay\n                className=\"w-full h-full object-contain\"\n              />\n            </div>\n          </div>\n        </div>\n      )}\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\DeliverIQ\\DeliverIQ\\src\\pages\\session-detail.tsx","messages":[{"ruleId":"no-undef","severity":2,"message":"'React' is not defined.","line":66,"column":34,"nodeType":"Identifier","messageId":"undef","endLine":66,"endColumn":39},{"ruleId":"no-undef","severity":2,"message":"'HTMLImageElement' is not defined.","line":182,"column":60,"nodeType":"Identifier","messageId":"undef","endLine":182,"endColumn":76},{"ruleId":"no-undef","severity":2,"message":"'HTMLImageElement' is not defined.","line":218,"column":60,"nodeType":"Identifier","messageId":"undef","endLine":218,"endColumn":76}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Helmet } from '@dr.pogodin/react-helmet';\nimport { useParams, Link, useNavigate } from 'react-router-dom';\nimport { motion } from 'motion/react';\nimport { useState } from 'react';\nimport { useCmsContent } from '@/lib/cms-client';\nimport { Calendar, Clock, ArrowRight, ArrowLeft, Users, Globe, CheckCircle, PlayCircle, Tag } from 'lucide-react';\nimport { notifySubmission } from '@/lib/notify';\n\nconst fadeUp = {\n  hidden: { opacity: 0, y: 20 },\n  visible: (d = 0) => ({\n    opacity: 1,\n    y: 0,\n    transition: { duration: 0.5, delay: d, ease: 'easeOut' as const }\n  })\n};\n\nconst stagger = {\n  hidden: {},\n  visible: { transition: { staggerChildren: 0.07 } }\n};\n\nfunction isPast(dateStr: string): boolean {\n  if (!dateStr) return false;\n  const d = new Date(dateStr);\n  const today = new Date();\n  d.setHours(0, 0, 0, 0);\n  today.setHours(0, 0, 0, 0);\n  return d < today;\n}\n\nexport default function SessionDetailPage() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const { data: cms } = useCmsContent();\n\n  const [name, setName] = useState('');\n  const [email, setEmail] = useState('');\n  const [submitted, setSubmitted] = useState(false);\n\n  if (!cms) return null;\n\n  const session = cms.sessions.find(s => s.id === id);\n\n  if (!session) {\n    return (\n      <main className=\"min-h-screen flex flex-col items-center justify-center text-center px-6 gap-6\">\n        <p className=\"text-4xl font-black text-[#2C2F38]\">404</p>\n        <h1 className=\"text-2xl font-bold text-[#F0EDE8]\">Session not found</h1>\n        <p className=\"text-sm text-[#8A8D96]\">This session may have been removed or the link is incorrect.</p>\n        <Link to=\"/sessions\" className=\"inline-flex items-center gap-2 text-sm font-semibold text-[#C79A4E] hover:underline\">\n          <ArrowLeft size={14} /> Back to Sessions\n        </Link>\n      </main>\n    );\n  }\n\n  const past = isPast(session.date);\n  const speakers = (cms.speakers || []).filter(sp => (session.speakerIds || []).includes(sp.id));\n  const sponsors = (cms.sponsors || []).filter(sp => (session.sponsorIds || []).includes(sp.id));\n\n  const site = 'https://deliveriq.live';\n  const title = `${session.title} ΓÇö DeliverIQ`;\n  const description = session.description;\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n    await notifySubmission({ source: `register:${session.title}`, name, email });\n  };\n\n  return (\n    <>\n      <Helmet>\n        <title>{title}</title>\n        <meta name=\"description\" content={description} />\n        <link rel=\"canonical\" href={`${site}/sessions/${session.id}`} />\n        <meta property=\"og:title\" content={title} />\n        <meta property=\"og:description\" content={description} />\n        <meta property=\"og:type\" content=\"website\" />\n        <meta property=\"og:url\" content={`${site}/sessions/${session.id}`} />\n      </Helmet>\n\n      <main>\n        {/* ΓöÇΓöÇ HERO ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n        <section className=\"relative overflow-hidden pt-20 pb-16 lg:pt-28 lg:pb-20\">\n          {/* Grid bg */}\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              backgroundImage: `\n                linear-gradient(rgba(44,47,56,0.35) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(44,47,56,0.35) 1px, transparent 1px)\n              `,\n              backgroundSize: '48px 48px'\n            }}\n          />\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            aria-hidden=\"true\"\n            style={{\n              background: 'radial-gradient(ellipse 60% 70% at 20% 50%, rgba(199,154,78,0.07) 0%, transparent 70%)'\n            }}\n          />\n\n          <div className=\"container mx-auto px-6 lg:px-8 relative z-10\">\n            {/* Back link */}\n            <button\n              onClick={() => navigate(-1)}\n              className=\"inline-flex items-center gap-1.5 text-xs text-[#8A8D96] hover:text-[#C79A4E] transition-colors mb-8 font-semibold\"\n            >\n              <ArrowLeft size={13} /> Back to Sessions\n            </button>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-12 lg:gap-16 items-start\">\n              {/* Left: Session Details */}\n              <motion.div initial=\"hidden\" animate=\"visible\" variants={stagger}>\n                {/* Tag + status badges */}\n                <motion.div variants={fadeUp} custom={0} className=\"flex flex-wrap items-center gap-2 mb-6\">\n                  <span className=\"inline-flex items-center gap-1.5 text-[10px] font-bold tracking-widest text-[#C79A4E] uppercase bg-[#C79A4E]/5 border border-[#C79A4E]/20 px-3 py-1 rounded-full\">\n                    <Tag size={10} /> {session.tag}\n                  </span>\n                  {past ? (\n                    <span className=\"text-[10px] font-bold text-[#8A8D96] uppercase tracking-wider bg-[#2C2F38]/60 border border-[#2C2F38] px-3 py-1 rounded-full\">\n                      Past Session\n                    </span>\n                  ) : (\n                    <span className=\"text-[10px] font-bold text-green-400 uppercase tracking-wider bg-green-950/30 border border-green-900/30 px-3 py-1 rounded-full animate-pulse\">\n                      Upcoming\n                    </span>\n                  )}\n                  {session.status === 'draft' && (\n                    <span className=\"text-[10px] font-bold text-yellow-400 uppercase tracking-wider bg-yellow-950/30 border border-yellow-900/30 px-3 py-1 rounded-full\">\n                      Draft\n                    </span>\n                  )}\n                </motion.div>\n\n                {/* Title */}\n                <motion.h1\n                  variants={fadeUp}\n                  custom={0.05}\n                  className=\"text-3xl md:text-4xl lg:text-5xl font-bold text-[#F0EDE8] leading-tight mb-6\"\n                >\n                  {session.title}\n                </motion.h1>\n\n                {/* Schedule row */}\n                <motion.div variants={fadeUp} custom={0.1} className=\"flex flex-wrap gap-5 mb-8\">\n                  <div className=\"flex items-center gap-2 text-sm text-[#8A8D96]\">\n                    <Calendar size={15} className=\"text-[#C79A4E] shrink-0\" />\n                    <span className=\"font-semibold\">{session.date || 'Date TBC'}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2 text-sm text-[#8A8D96]\">\n                    <Clock size={15} className=\"text-[#C79A4E] shrink-0\" />\n                    <span className=\"font-semibold\">{session.time || 'Time TBC'} &nbsp;┬╖&nbsp; {session.duration}</span>\n                  </div>\n                </motion.div>\n\n                {/* Description */}\n                <motion.div variants={fadeUp} custom={0.15} className=\"mb-10\">\n                  <h2 className=\"text-[11px] font-bold text-[#8A8D96] uppercase tracking-widest mb-3\">About this session</h2>\n                  <p className=\"text-base text-[#8A8D96] leading-relaxed max-w-2xl\">{session.description}</p>\n                </motion.div>\n\n                {/* Divider */}\n                <div className=\"w-full h-px bg-[#2C2F38] mb-10\" />\n\n                {/* Speakers */}\n                {speakers.length > 0 && (\n                  <motion.div variants={fadeUp} custom={0.2} className=\"mb-10\">\n                    <h2 className=\"text-[11px] font-bold text-[#8A8D96] uppercase tracking-widest mb-4 flex items-center gap-2\">\n                      <Users size={12} /> Presenters\n                    </h2>\n                    <div className=\"flex flex-col gap-4\">\n                      {speakers.map(sp => (\n                        <div key={sp.id} className=\"flex items-start gap-4 border border-[#2C2F38] bg-[#21242C]/40 rounded-sm p-4\">\n                          <img\n                            src={sp.avatarUrl}\n                            alt={sp.name}\n                            onError={(e) => { (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=64&h=64'; }}\n                            className=\"w-12 h-12 rounded-full object-cover border border-[#2C2F38] shrink-0\"\n                          />\n                          <div className=\"flex-1 min-w-0\">\n                            <p className=\"font-bold text-[#F0EDE8] text-sm\">{sp.name}</p>\n                            <p className=\"text-xs text-[#C79A4E] font-medium mb-1\">{sp.role} ┬╖ {sp.organisation}</p>\n                            {sp.bio && <p className=\"text-xs text-[#8A8D96] leading-relaxed line-clamp-3\">{sp.bio}</p>}\n                          </div>\n                          {sp.socialUrl && (\n                            <a href={sp.socialUrl} target=\"_blank\" rel=\"noreferrer\" className=\"text-[#8A8D96] hover:text-[#C79A4E] transition-colors shrink-0\">\n                              <Globe size={14} />\n                            </a>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  </motion.div>\n                )}\n\n                {/* Sponsors */}\n                {sponsors.length > 0 && (\n                  <motion.div variants={fadeUp} custom={0.25} className=\"mb-10\">\n                    <h2 className=\"text-[11px] font-bold text-[#8A8D96] uppercase tracking-widest mb-4\">Session Sponsors</h2>\n                    <div className=\"flex flex-wrap gap-3\">\n                      {sponsors.map(sp => (\n                        <a\n                          key={sp.id}\n                          href={sp.websiteUrl}\n                          target=\"_blank\"\n                          rel=\"noreferrer\"\n                          className=\"flex items-center gap-3 border border-[#2C2F38] bg-[#21242C]/40 rounded-sm px-4 py-3 hover:border-[#C79A4E]/30 transition-colors\"\n                          title={sp.name}\n                        >\n                          <img\n                            src={sp.logoUrl}\n                            alt={sp.name}\n                            onError={(e) => { (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=48&h=48'; }}\n                            className=\"h-6 max-w-[80px] object-contain filter brightness-90\"\n                          />\n                          <span className=\"text-xs font-semibold text-[#8A8D96]\">{sp.name}</span>\n                          {sp.tier && <span className=\"text-[10px] text-[#C79A4E] border border-[#C79A4E]/20 bg-[#C79A4E]/5 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider\">{sp.tier}</span>}\n                        </a>\n                      ))}\n                    </div>\n                  </motion.div>\n                )}\n              </motion.div>\n\n              {/* Right: Registration / Replay Card */}\n              <motion.div\n                initial={{ opacity: 0, x: 20 }}\n                animate={{ opacity: 1, x: 0 }}\n                transition={{ duration: 0.6, delay: 0.2 }}\n                className=\"lg:sticky lg:top-28\"\n              >\n                <div className=\"border border-[#2C2F38] bg-[#21242C] rounded-sm overflow-hidden\">\n                  <div className=\"px-6 py-4 border-b border-[#2C2F38] flex items-center justify-between\">\n                    <p className=\"text-[10px] font-bold tracking-widest text-[#C79A4E] uppercase\">\n                      {past ? 'Session Ended' : 'Register Interest'}\n                    </p>\n                    <span className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${\n                      past\n                        ? 'text-[#8A8D96] border-[#2C2F38] bg-[#2C2F38]/30'\n                        : 'text-green-400 border-green-900/40 bg-green-950/20'\n                    }`}>\n                      {past ? 'Completed' : 'Open'}\n                    </span>\n                  </div>\n\n                  {/* Schedule summary */}\n                  <div className=\"px-6 py-4 border-b border-[#2C2F38]/60 bg-[#1A1D24]/60\">\n                    <div className=\"flex flex-col gap-2 text-xs\">\n                      <div className=\"flex items-center gap-2 text-[#8A8D96]\">\n                        <Calendar size={12} className=\"text-[#C79A4E] shrink-0\" />\n                        <span>{session.date || 'Date TBC'}</span>\n                      </div>\n                      <div className=\"flex items-center gap-2 text-[#8A8D96]\">\n                        <Clock size={12} className=\"text-[#C79A4E] shrink-0\" />\n                        <span>{session.time || 'Time TBC'} ┬╖ {session.duration}</span>\n                      </div>\n                      <div className=\"flex items-center gap-2 text-[#8A8D96]\">\n                        <Tag size={12} className=\"text-[#C79A4E] shrink-0\" />\n                        <span>{session.tag}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {past ? (\n                    /* Past session ΓÇö show replay CTA */\n                    <div className=\"px-6 py-8 flex flex-col items-center text-center gap-4\">\n                      <PlayCircle size={36} className=\"text-[#8A8D96]\" />\n                      <p className=\"text-sm font-semibold text-[#F0EDE8]\">This session has ended</p>\n                      <p className=\"text-xs text-[#8A8D96] leading-relaxed\">If a replay was recorded, you can watch it on the Replays page.</p>\n                      {session.videoUrl ? (\n                        <Link\n                          to=\"/replays\"\n                          className=\"w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#C79A4E]/10 border border-[#C79A4E]/30 text-[#C79A4E] hover:bg-[#C79A4E]/20 text-sm font-semibold rounded-sm transition-all\"\n                        >\n                          <PlayCircle size={14} /> Watch Replay\n                        </Link>\n                      ) : (\n                        <p className=\"text-xs text-[#8A8D96] italic\">Replay not yet available.</p>\n                      )}\n                    </div>\n                  ) : submitted ? (\n                    /* Submitted state */\n                    <div className=\"px-6 py-10 flex flex-col items-center text-center gap-3\">\n                      <CheckCircle size={36} className=\"text-[#C79A4E]\" />\n                      <p className=\"text-base font-bold text-[#F0EDE8]\">You're on the list!</p>\n                      <p className=\"text-xs text-[#8A8D96] leading-relaxed max-w-xs\">\n                        We'll notify you as soon as registration opens for this session.\n                      </p>\n                    </div>\n                  ) : (\n                    /* Registration form */\n                    <form onSubmit={handleSubmit} className=\"px-6 py-6 flex flex-col gap-4\">\n                      <p className=\"text-xs text-[#8A8D96] leading-relaxed\">\n                        Register your interest and we'll notify you when registration opens for this session.\n                      </p>\n                      <div className=\"flex flex-col gap-1.5\">\n                        <label className=\"text-[10px] font-bold text-[#8A8D96] uppercase tracking-wider\">Full name *</label>\n                        <input\n                          type=\"text\"\n                          required\n                          value={name}\n                          onChange={e => setName(e.target.value)}\n                          placeholder=\"Your name\"\n                          className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm px-4 py-2.5 text-sm text-[#F0EDE8] placeholder-[#4A4D56] focus:outline-none focus:border-[#C79A4E]/60 transition-colors\"\n                        />\n                      </div>\n                      <div className=\"flex flex-col gap-1.5\">\n                        <label className=\"text-[10px] font-bold text-[#8A8D96] uppercase tracking-wider\">Work email *</label>\n                        <input\n                          type=\"email\"\n                          required\n                          value={email}\n                          onChange={e => setEmail(e.target.value)}\n                          placeholder=\"you@company.com\"\n                          className=\"bg-[#1A1D24] border border-[#2C2F38] rounded-sm px-4 py-2.5 text-sm text-[#F0EDE8] placeholder-[#4A4D56] focus:outline-none focus:border-[#C79A4E]/60 transition-colors\"\n                        />\n                      </div>\n                      <button\n                        type=\"submit\"\n                        className=\"mt-1 inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold bg-[#C79A4E] text-[#1A1D24] rounded-sm hover:brightness-110 transition-all\"\n                      >\n                        Register My Interest <ArrowRight size={14} />\n                      </button>\n                      <p className=\"text-[10px] text-[#4A4D56] text-center\">No spam ΓÇö session updates only.</p>\n                    </form>\n                  )}\n                </div>\n\n                {/* Back to sessions link */}\n                <Link\n                  to=\"/sessions\"\n                  className=\"mt-4 flex items-center justify-center gap-1.5 text-xs text-[#8A8D96] hover:text-[#C79A4E] transition-colors font-semibold\"\n                >\n                  <ArrowLeft size={12} /> All Sessions\n                </Link>\n              </motion.div>\n            </div>\n          </div>\n        </section>\n      </main>\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\DeliverIQ\\DeliverIQ\\src\\pages\\sessions.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\DeliverIQ\\DeliverIQ\\src\\pages\\terms.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\DeliverIQ\\DeliverIQ\\src\\router-hooks.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":14,"column":69,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":14,"endColumn":72,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[493,496],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[493,496],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],